# =============================================================================
# comfyui-worker (ComfyUI 推理引擎) — PyTorch 2.6 + CUDA 12.4 + Ubuntu 22.04
# =============================================================================
# 解决 glibc 2.31 (Ubuntu 20.04) → glibc 2.35 (Ubuntu 22.04) 兼容问题
# 支持 TRELLIS 2 / Hunyuan3D / FLUX / Wan2.1 等需要新版 CUDA 扩展的模型
# 需要 NVIDIA GPU (RTX 3090, 24GB VRAM)
# =============================================================================

FROM nvidia/cuda:12.4.0-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# -------------------------------------------------------------------------
# 系统依赖
# -------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 python3.10-venv python3-pip \
    git git-lfs \
    libgl1 libglib2.0-0 libjpeg-dev libpng-dev \
    ffmpeg \
    wget curl \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.10 /usr/bin/python3 \
    && ln -sf /usr/bin/python3.10 /usr/bin/python

# -------------------------------------------------------------------------
# Python 基础依赖
# -------------------------------------------------------------------------
RUN python -m pip install --no-cache-dir --break-system-packages \
    pip setuptools wheel

# -------------------------------------------------------------------------
# PyTorch 2.6 + CUDA 12.4
# -------------------------------------------------------------------------
RUN pip install --no-cache-dir --break-system-packages \
    torch==2.6.0 torchvision==0.21.0 torchaudio==2.6.0 \
    --index-url https://download.pytorch.org/whl/cu124 \
    && pip install --no-cache-dir --break-system-packages \
    nvidia-cudnn-cu12==9.1.0.70

# -------------------------------------------------------------------------
# ComfyUI
# -------------------------------------------------------------------------
WORKDIR /app
RUN git clone --depth 1 https://ghfast.top/https://github.com/comfyanonymous/ComfyUI.git /app/ComfyUI

# ComfyUI Python 依赖
RUN cd /app/ComfyUI && \
    pip install --no-cache-dir --break-system-packages \
    -r requirements.txt

# -------------------------------------------------------------------------
# 通用 GPU 依赖 (flash-attn, spconv, 等)
# -------------------------------------------------------------------------
RUN pip install --no-cache-dir --break-system-packages \
    ninja \
    flash-attn==2.7.3 \
    spconv-cu124 \
    xformers \
    einops

# -------------------------------------------------------------------------
# TRELLIS 2 依赖 (cumesh, o_voxel, flex_gemm)
# -------------------------------------------------------------------------
# cumesh - clone and build
RUN cd /tmp && \
    git clone --depth 1 --recurse-submodules --shallow-submodules \
    https://ghfast.top/https://github.com/JeffreyXiang/CuMesh.git && \
    cd CuMesh && \
    pip install . --no-build-isolation --break-system-packages && \
    rm -rf /tmp/CuMesh

# flex_gemm - clone and build
RUN cd /tmp && \
    git clone --depth 1 --recurse-submodules --shallow-submodules \
    https://ghfast.top/https://github.com/JeffreyXiang/FlexGEMM.git && \
    cd FlexGEMM && \
    pip install . --no-build-isolation --break-system-packages && \
    rm -rf /tmp/FlexGEMM

# o_voxel - from TRELLIS.2 repo
RUN cd /tmp && \
    git clone --depth 1 https://ghfast.top/https://github.com/microsoft/TRELLIS.2.git && \
    cd TRELLIS.2/o-voxel && \
    pip install . --no-build-isolation --break-system-packages && \
    rm -rf /tmp/TRELLIS.2

# -------------------------------------------------------------------------
# ComfyUI TRELLIS2 节点依赖
# -------------------------------------------------------------------------
RUN pip install --no-cache-dir --break-system-packages \
    uv \
    comfy-env==0.3.89 \
    comfy-3d-viewers==0.2.44 \
    comfy-sparse-attn==0.1.3

# -------------------------------------------------------------------------
# 其他常用节点依赖
# -------------------------------------------------------------------------
RUN pip install --no-cache-dir --break-system-packages \
    trimesh[easy] \
    open3d \
    rembg \
    pillow imageio imageio-ffmpeg

# -------------------------------------------------------------------------
# 验证
# -------------------------------------------------------------------------
RUN python3 -c 'import torch; print(f"PyTorch {torch.__version__}, CUDA {torch.version.cuda}"); assert torch.cuda.is_available(), "CUDA not available"; print(f"GPU: {torch.cuda.get_device_name(0)}"); import cumesh; print("cumesh OK"); import o_voxel; print("o_voxel OK"); import flex_gemm; print("flex_gemm OK"); import spconv; print("spconv OK"); print("All TRELLIS 2 dependencies verified!")'

# -------------------------------------------------------------------------
# 数据目录
# -------------------------------------------------------------------------
RUN mkdir -p /mnt/agents/output

# ComfyUI 环境变量
ENV COMFYUI_LISTEN=0.0.0.0
ENV COMFYUI_PORT=8188
ENV CUDA_HOME=/usr/local/cuda

EXPOSE 8188

WORKDIR /app/ComfyUI
CMD ["python", "main.py", "--listen", "0.0.0.0", "--port", "8188"]
