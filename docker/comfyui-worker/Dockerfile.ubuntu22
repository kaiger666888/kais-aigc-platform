# =============================================================================
# comfyui-worker (ComfyUI 推理引擎) — PyTorch 2.6 + CUDA 12.4 + Python 3.12
# =============================================================================
# 解决 glibc 2.31 (Ubuntu 20.04) → glibc 2.35 (Ubuntu 22.04) 兼容问题
# 支持 TRELLIS 2 / Hunyuan3D / FLUX / Wan2.1 等需要新版 CUDA 扩展的模型
# 需要 NVIDIA GPU (RTX 3090, 24GB VRAM)
# =============================================================================
# v6: 切换到 Python 3.12 以支持 TRELLIS2 预编译 wheel (cumesh_vb, flex_gemm_ap,
#     o_voxel_vb_ap 仅提供 cp312/cp313 版本)。移除 CuMesh/FlexGEMM/o-voxel 源码
#     编译 (因 torch.version.cuda=13.0 vs 系统 CUDA toolkit 12.4 不匹配)。
#     TRELLIS2 扩展通过 comfy-env 启动时安装。
# =============================================================================

FROM nvidia/cuda:12.4.0-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Docker build 环境通过宿主网桥 172.18.0.1:7890 代理访问外网
ENV http_proxy=http://172.18.0.1:7890
ENV https_proxy=http://172.18.0.1:7890
ENV HTTP_PROXY=http://172.18.0.1:7890
ENV HTTPS_PROXY=http://172.18.0.1:7890

# -------------------------------------------------------------------------
# 系统依赖 + Python 3.12 (deadsnakes PPA)
# -------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-venv python3.12-dev \
    git git-lfs \
    libgl1 libglib2.0-0 libjpeg-dev libpng-dev \
    ffmpeg \
    wget curl build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.12 /usr/bin/python3 \
    && ln -sf /usr/bin/python3.12 /usr/bin/python

# -------------------------------------------------------------------------
# Python 基础依赖
# -------------------------------------------------------------------------
RUN wget -q https://bootstrap.pypa.io/get-pip.py -O /tmp/get-pip.py && \
    python3 /tmp/get-pip.py --break-system-packages && \
    rm /tmp/get-pip.py

# -------------------------------------------------------------------------
# PyTorch 2.6 + CUDA 12.4
# -------------------------------------------------------------------------
RUN pip install --no-cache-dir --break-system-packages \
    torch==2.6.0 torchvision==0.21.0 torchaudio==2.6.0 \
    --index-url https://download.pytorch.org/whl/cu124 \
    && pip install --no-cache-dir --break-system-packages \
    nvidia-cudnn-cu12==9.1.0.70

# -------------------------------------------------------------------------
# ComfyUI
# -------------------------------------------------------------------------
WORKDIR /app
RUN git clone --depth 1 https://ghfast.top/https://github.com/comfyanonymous/ComfyUI.git /app/ComfyUI

# ComfyUI Python 依赖
RUN cd /app/ComfyUI && \
    pip install --no-cache-dir --break-system-packages \
    -r requirements.txt

# -------------------------------------------------------------------------
# 通用 GPU 依赖 (flash-attn, spconv, 等)
# -------------------------------------------------------------------------
RUN pip install --no-cache-dir --break-system-packages \
    ninja \
    einops
RUN pip install --no-build-isolation --break-system-packages --retries 10 --timeout 300 \
    flash-attn==2.7.3
RUN pip install --no-cache-dir --break-system-packages \
    spconv-cu124 \
    xformers==0.0.28.post2

# -------------------------------------------------------------------------
# ComfyUI TRELLIS2 节点依赖
# -------------------------------------------------------------------------
RUN pip install --no-cache-dir --break-system-packages \
    uv \
    comfy-env==0.3.89 \
    comfy-3d-viewers==0.2.44 \
    comfy-sparse-attn==0.1.3

# -------------------------------------------------------------------------
# 其他常用节点依赖
# -------------------------------------------------------------------------
RUN pip install --no-cache-dir --break-system-packages \
    trimesh[easy] \
    open3d \
    rembg \
    pillow imageio imageio-ffmpeg

# -------------------------------------------------------------------------
# 验证 (基础依赖)
# -------------------------------------------------------------------------
RUN python3 -c 'import torch; print(f"PyTorch {torch.__version__}, CUDA {torch.version.cuda}"); import spconv; print("spconv OK"); print("Base dependencies verified!")'

# -------------------------------------------------------------------------
# 数据目录
# -------------------------------------------------------------------------
RUN mkdir -p /mnt/agents/output

# ComfyUI 环境变量
ENV COMFYUI_LISTEN=0.0.0.0
ENV COMFYUI_PORT=8188
ENV CUDA_HOME=/usr/local/cuda

EXPOSE 8188

# -------------------------------------------------------------------------
# 启动脚本: 通过 comfy-env 安装 TRELLIS2 扩展后启动 ComfyUI
# -------------------------------------------------------------------------
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /app/ComfyUI
CMD ["/entrypoint.sh"]
