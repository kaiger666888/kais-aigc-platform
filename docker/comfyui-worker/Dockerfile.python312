# =============================================================================
# comfyui-worker — PyTorch 2.5 + CUDA 12.4 + Python 3.12
# =============================================================================
# v7: cu124+torch2.5+cp312 (cumesh_vb 只有这个组合)
# =============================================================================

FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-venv python3.12-dev \
    git git-lfs libgl1 libglib2.0-0 libjpeg-dev libpng-dev ffmpeg wget curl build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.12 /usr/bin/python3 \
    && ln -sf /usr/bin/python3.12 /usr/bin/python

RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3.12 && \
    python3.12 -m pip install --no-cache-dir --break-system-packages pip setuptools wheel

RUN pip install --no-cache-dir --break-system-packages \
    torch==2.5.1 torchvision==0.20.1 torchaudio==2.5.1 --index-url https://download.pytorch.org/whl/cu124 && \
    pip install --no-cache-dir --break-system-packages nvidia-cudnn-cu12

WORKDIR /app
RUN git clone --depth 1 https://ghfast.top/https://github.com/comfyanonymous/ComfyUI.git /app/ComfyUI
RUN cd /app/ComfyUI && pip install --no-cache-dir --break-system-packages -r requirements.txt

RUN pip install --no-cache-dir --break-system-packages \
    comfy-env==0.3.89 comfy-3d-viewers==0.2.44 comfy-sparse-attn==0.1.3 "trimesh[easy]"

RUN cd /app/ComfyUI/custom_nodes && \
    git clone --depth 1 https://ghfast.top/https://github.com/PozzettiAndrea/ComfyUI-TRELLIS2.git && \
    git clone --depth 1 https://ghfast.top/https://github.com/PozzettiAndrea/ComfyUI-GeometryPack.git

# CUDA wheels install script (written to file to avoid Dockerfile parsing issues)
COPY <<'PYEOF' /tmp/install_cuda_wheels.py
import zipfile, shutil, os, glob
site_packages = '/usr/local/lib/python3.12/dist-packages'
for whl in glob.glob('/tmp/cuda-wheels/*.whl'):
    with zipfile.ZipFile(whl, 'r') as z:
        z.extractall('/tmp/whl_extract')
    for item in os.listdir('/tmp/whl_extract'):
        src = os.path.join('/tmp/whl_extract', item)
        dst = os.path.join(site_packages, item)
        if os.path.exists(dst):
            shutil.rmtree(dst) if os.path.isdir(dst) else os.remove(dst)
        shutil.copytree(src, dst) if os.path.isdir(src) else shutil.copy2(src, dst)
    shutil.rmtree('/tmp/whl_extract')
    print(f'Installed {os.path.basename(whl)}')
PYEOF

RUN mkdir -p /tmp/cuda-wheels && cd /tmp/cuda-wheels && \
    curl -L -o cumesh_vb.whl "https://github.com/PozzettiAndrea/cuda-wheels/releases/download/cumesh_vb-latest/cumesh_vb-0.0.1%2Bcu124torch2.5-cp312-cp312-manylinux_2_35_x86_64.whl" && \
    curl -L -o flex_gemm_ap.whl "https://github.com/PozzettiAndrea/cuda-wheels/releases/download/flex_gemm_ap-latest/flex_gemm_ap-1.0.0%2Bcu124torch2.5-cp312-cp312-manylinux_2_34_x86_64.manylinux_2_35_x86_64.whl" && \
    curl -L -o o_voxel_vb_ap.whl "https://github.com/PozzettiAndrea/cuda-wheels/releases/download/o_voxel_vb_ap-latest/o_voxel_vb_ap-0.0.1%2Bcu124torch2.5-cp312-cp312-manylinux_2_34_x86_64.manylinux_2_35_x86_64.whl" && \
    curl -L -o flash_attn.whl "https://github.com/PozzettiAndrea/cuda-wheels/releases/download/flash_attn-latest/flash_attn-2.8.3%2Bcu124torch2.5-cp312-cp312-manylinux_2_34_x86_64.manylinux_2_35_x86_64.whl" && \
    curl -L -o sageattention.whl "https://github.com/PozzettiAndrea/cuda-wheels/releases/download/sageattention-latest/sageattention-2.2.0%2Bcu124torch2.5-cp312-cp312-manylinux_2_34_x86_64.manylinux_2_35_x86_64.whl" && \
    python3 /tmp/install_cuda_wheels.py && rm -rf /tmp/cuda-wheels /tmp/whl_extract

RUN python3 -c 'import sys; import torch; print(f"PyTorch {torch.__version__}, CUDA {torch.version.cuda}, Python {sys.version}")'
RUN python3 -c 'import cumesh_vb; print("cumesh_vb OK")'

RUN mkdir -p /mnt/agents/output

ENV COMFYUI_LISTEN=0.0.0.0
ENV COMFYUI_PORT=8188
ENV CUDA_HOME=/usr/local/cuda
ENV HF_ENDPOINT=https://hf-mirror.com

EXPOSE 8188
WORKDIR /app/ComfyUI
CMD ["python", "main.py", "--listen", "0.0.0.0", "--port", "8188"]
