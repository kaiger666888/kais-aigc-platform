{
  "name": "kais-core-backend",
  "version": "6.0.0",
  "description": "Toonflow 是一款 AI 短剧漫剧工具，能够利用 AI 技术将小说自动转化为剧本，并结合 AI 生成的图片和视频，实现高效的短剧创作。",
  "author": "HBAI-Ltd <ltlctools@outlook.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/HBAI-Ltd/Toonflow-app#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HBAI-Ltd/Toonflow-app.git"
  },
  "bugs": {
    "url": "https://github.com/HBAI-Ltd/Toonflow-app/issues",
    "email": "ltlctools@outlook.com"
  },
  "main": "build/main.js",
  "packageManager": "yarn@1.0.0",
  "engines": {
    "node": ">=1.0.0"
  },
  "scripts": {
    "backfill:phase-50": "npx tsx scripts/backfill-candidate-groups.ts",
    "build:server": "node -e \"const e=require('esbuild');const pkg=require('./package.json');e.build({entryPoints:['src/app.ts'],bundle:true,format:'cjs',allowOverwrite:true,outfile:'data/serve/app.js',platform:'node',target:'esnext',tsconfig:'./tsconfig.json',alias:{'@':'./src'},sourcemap:false,external:['electron','@huggingface/transformers','onnxruntime-node','vm2','sqlite3','better-sqlite3','sharp','mysql','mysql2','pg','pg-query-stream','oracledb','tedious','mssql'],define:{__APP_VERSION__:JSON.stringify(pkg.version)},logOverride:{'top-level-await':'silent'}}).then(()=>console.log('✅ Built data/serve/app.js')).catch(e=>{console.error(e);process.exit(1);})\"",
    "debug:ai": "npx @ai-sdk/devtools",
    "dev": "nodemon --inspect --exec tsx src/app.ts",
    "dev:server": "nodemon --inspect --exec tsx src/app.ts",
    "lint": "tsc --noEmit",
    "start": "cross-env NODE_ENV=prod node data/serve/app.js",
    "start:server": "cross-env NODE_ENV=prod node data/serve/app.js",
    "verify:engine-integration": "npx tsx scripts/verify-engine-integration.ts",
    "verify:import-roundtrip": "npx tsx scripts/canvas/verify-import-roundtrip.ts",
    "verify:manifest-contract": "npx tsx scripts/verify-manifest-contract.ts",
    "verify:phase-41": "npx tsx scripts/verify-phase-41.ts",
    "verify:phase-44": "npx tsx scripts/canvas/verify-schema-roundtrip.ts",
    "verify:phase-45": "npx tsx scripts/verify-phase-45.ts",
    "verify:phase-46-contracts": "npm run verify:manifest-contract && npm run verify:import-roundtrip && npm run verify:schema-drift",
    "verify:phase-46-e2e": "npx tsx scripts/verify-phase-46-e2e.ts",
    "verify:phase-47-backfill": "npx tsx scripts/verify-phase-47-backfill.ts",
    "verify:phase-48": "npx tsx scripts/verify-phase-48.ts",
    "verify:phase-49": "npx tsx scripts/verify-phase-49.ts",
    "verify:phase-49-bridge": "npx tsx scripts/verify-phase-49-bridge.ts",
    "verify:phase-49-linkage": "npx tsx scripts/verify-phase-49-linkage.ts",
    "verify:phase-50": "npx tsx scripts/verify-phase-50.ts",
    "verify:phase-51": "npx tsx scripts/verify-phase-51.ts",
    "verify:phase-53": "npx tsx scripts/verify-phase-53.ts",
    "verify:phase-54": "npx tsx scripts/verify-phase-54.ts",
    "verify:phase-55": "npx tsx scripts/verify-phase-55.ts",
    "verify:phase-56": "npx tsx scripts/verify-phase-56.ts",
    "verify:phase-57": "npx tsx scripts/verify-phase-57.ts",
    "verify:qwen-tts": "npx tsx scripts/verify-qwen-tts.ts",
    "verify:schema-drift": "npx tsx scripts/canvas/verify-schema-drift.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.35",
    "@ai-sdk/deepseek": "^2.0.17",
    "@ai-sdk/devtools": "^0.0.11",
    "@ai-sdk/google": "^3.0.20",
    "@ai-sdk/openai": "^3.0.25",
    "@ai-sdk/openai-compatible": "^2.0.27",
    "@ai-sdk/xai": "^3.0.47",
    "@huggingface/transformers": "^3.8.1",
    "@rmp135/sql-ts": "^2.2.0",
    "@types/js-yaml": "^4.0.9",
    "ai": "^6.0.67",
    "axios": "^1.13.2",
    "axios-retry": "^4.5.0",
    "better-sqlite3": "^12.9.0",
    "compressing": "^2.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-ws": "^5.0.2",
    "fast-glob": "^3.3.3",
    "form-data": "^4.0.5",
    "graphlib": "^2.1.8",
    "ioredis": "^5.11.1",
    "is-path-inside": "^4.0.0",
    "js-md5": "^0.8.3",
    "js-yaml": "^4.2.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.2.5",
    "lodash": "^4.17.23",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "p-limit": "^7.3.0",
    "playwright": "^1.61.1",
    "puppeteer-core": "^22.15.0",
    "qwen-ai-provider-v5": "^2.1.0",
    "semver": "^7.8.5",
    "serialize-error": "^13.0.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1",
    "sucrase": "^3.35.1",
    "uuid": "^13.0.0",
    "vercel-minimax-ai-provider": "^0.0.2",
    "vm2": "^3.10.5",
    "zhipu-ai-provider": "^0.2.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-ws": "^3.0.6",
    "@types/graphlib": "^2.1.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/license-checker": "^25.0.6",
    "@types/lodash": "^4.17.24",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.0",
    "license-checker": "^25.0.1",
    "nodemon": "^3.1.11",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@rmp135/sql-ts": {
      "better-sqlite3": "^12.8.0"
    }
  }
}
