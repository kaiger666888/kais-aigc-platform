# =============================================================================
# KAIS AIGC Platform V6.0 — Environment Variables
# =============================================================================
# 复制为 .env 并填写实际值: cp .env.example .env
# =============================================================================

# ----- 通用 -----
NODE_ENV=production
OUTPUT_DIR=/mnt/agents/output
MODELS_DIR=/opt/kais/models

# ----- GPU 角色化 (双3090 扩展, docs/gpu-dual-3090-expansion.md) -----
# docker-compose.v9.yml 的 CDI 设备注入参数 (2026-09-04 起 devices: nvidia.com/gpu=;
# 勿再设 device_ids / NVIDIA_VISIBLE_DEVICES legacy 路线)。默认值 = 今日拓扑
# (GPU0 3060Ti / GPU1 3090)。新 3090 插卡日由 /opt/kais-gpu/dual-3090-setup.sh 按
# PCIe 枚举实况回填本文件 (防枚举漂移); 角色→UUID 唯一真源在 /opt/kais-gpu/gpu.conf,
# TS 侧解析见 src/services/gpu/gpuRoles.ts。
#KAIS_RENDER_GPU_UUID=c5cdd49c-f5a8-7d0b-2af5-1d2f642538c6
#KAIS_AUX_GPU_UUID=efe011dd-82a0-a20f-6ad8-eaa21aaf8570

# ----- 端口映射 -----
CORE_PORT=8000
GOLD_TEAM_PORT=8002
COMFYUI_PORT=8188
REVIEW_PORT=8090
# kap 服务端直连 review-platform 的基址(54-01 P0:宿主 systemd 进程用 localhost;容器内拓扑用 http://review-platform:8090)
REVIEW_PLATFORM_URL=http://localhost:8090
POSTGRES_PORT=5432
REDIS_PORT=6379

# ----- PostgreSQL (audit-db) -----
POSTGRES_USER=kais
POSTGRES_PASSWORD=changeme_use_strong_password
POSTGRES_DB=kais_audit

# ----- Redis (GPU 协调面, R1 2026-09-06) -----
# KAP 当前为宿主机 systemd 形态 (unit kais-aigc-platform) — redis 走宿主映射端口
# 6390 (容器 kais-aigc-platform-redis-1 的 6379 → 宿主 6390, 无认证)。
# 容器形态 (docker compose) 才用 redis://redis:6379 — compose environment 已对
# gold-team 等容器显式覆盖, 宿主 .env 设 6390 不影响容器取值。
# 作用: GpuScheduler 状态锁跨进程互斥 + gpuQueue 跨进程门控; 未设 = 降级单进程
# 内存态 (journalctl 可见 "REDIS_URL not set" WARN)。
REDIS_URL=redis://127.0.0.1:6390
# GPU 队列跨进程门控三档 (src/lib/gpuQueueCrossProc.ts):
#   off     完全关闭 (REDIS_URL 未设时的默认)
#   mirror  持锁镜像到 redis + 异主碰撞检测 (只告警不阻塞; REDIS_URL 已设时的默认)
#   strict  进程内获锁后还要拿 redis 互斥锁 (SET NX PX + 心跳 + Lua 释放) 才执行 —
#           多进程 (dev tsx ×2 + prod bundle) 真互斥; TTL 40min 兜底进程崩溃残留。
# redis 不可达时 mirror/strict 均 fail-open 降级 off + ERROR log (业务不停摆)。
KAP_GPU_QUEUE_CROSSPROC=strict

# ----- Telegram Bot -----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----- 云端引擎 API Keys -----
KLING_API_KEY=
JIMENG_API_KEY=
JIMENG_SESSION=
SEEDANCE_API_KEY=
RUNWAY_API_KEY=
LUMA_API_KEY=

# ----- ComfyUI -----
COMFYUI_LISTEN=0.0.0.0

# ----- ACE-Step Music Generation -----
ACESTEP_MODELS_DIR=/data/models/ACE-Step1.5
ACESTEP_API_PORT=8009
ACESTEP_CONFIG_PATH=acestep-v15-xl-turbo
ACESTEP_CONFIG_PATH2=acestep-v15-xl-sft
ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-4B
ACESTEP_LLM_BACKEND=pt
# ACE-Step project dir (for Docker build context)
ACESTEP_PROJECT_DIR=../ACE-Step-1.5
