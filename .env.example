# =============================================================================
# KAIS AIGC Platform V6.0 — Environment Variables
# =============================================================================
# 复制为 .env 并填写实际值: cp .env.example .env
# =============================================================================

# ----- 通用 -----
NODE_ENV=production
OUTPUT_DIR=/mnt/agents/output
MODELS_DIR=/opt/kais/models

# ----- GPU 角色化 (双3090 扩展, docs/gpu-dual-3090-expansion.md) -----
# docker-compose.v9.yml 的 device_ids / NVIDIA_VISIBLE_DEVICES 参数。默认值 = 今日拓扑
# (GPU0 3060Ti / GPU1 3090)。新 3090 插卡日由 /opt/kais-gpu/dual-3090-setup.sh 按
# PCIe 枚举实况回填本文件 (防枚举漂移); 角色→UUID 唯一真源在 /opt/kais-gpu/gpu.conf,
# TS 侧解析见 src/services/gpu/gpuRoles.ts。
#KAIS_RENDER_GPU_INDEX=1
#KAIS_AUX_GPU_INDEX=0

# ----- 端口映射 -----
CORE_PORT=8000
GOLD_TEAM_PORT=8002
COMFYUI_PORT=8188
REVIEW_PORT=8090
# kap 服务端直连 review-platform 的基址(54-01 P0:宿主 systemd 进程用 localhost;容器内拓扑用 http://review-platform:8090)
REVIEW_PLATFORM_URL=http://localhost:8090
POSTGRES_PORT=5432
REDIS_PORT=6379

# ----- PostgreSQL (audit-db) -----
POSTGRES_USER=kais
POSTGRES_PASSWORD=changeme_use_strong_password
POSTGRES_DB=kais_audit

# ----- Redis -----
# REDIS_URL=redis://redis:6379  (容器内自动设置)

# ----- Telegram Bot -----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----- 云端引擎 API Keys -----
KLING_API_KEY=
JIMENG_API_KEY=
JIMENG_SESSION=
SEEDANCE_API_KEY=
RUNWAY_API_KEY=
LUMA_API_KEY=

# ----- ComfyUI -----
COMFYUI_LISTEN=0.0.0.0

# ----- ACE-Step Music Generation -----
ACESTEP_MODELS_DIR=/data/models/ACE-Step1.5
ACESTEP_API_PORT=8009
ACESTEP_CONFIG_PATH=acestep-v15-xl-turbo
ACESTEP_CONFIG_PATH2=acestep-v15-xl-sft
ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-4B
ACESTEP_LLM_BACKEND=pt
# ACE-Step project dir (for Docker build context)
ACESTEP_PROJECT_DIR=../ACE-Step-1.5
